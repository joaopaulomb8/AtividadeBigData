    {
      "cell_type": "code",
      "source": [
        "resultados = []\n",
        "\n",
        "for N in N_values:\n",
        "\n",
        "    print(f\"Executando N = {N:,}...\")\n",
        "\n",
        "    # Geração dos dados\n",
        "    dados = np.random.randint(0, N * 10, size=N)\n",
        "\n",
        "    # O maior valor é usado como chave\n",
        "    chave = dados.max()\n",
        "\n",
        "    # Ordenação necessária para Jump e Binária\n",
        "    dados_ordenados = np.sort(dados)\n",
        "\n",
        "    # -----------------------------\n",
        "    # BUSCA SEQUENCIAL\n",
        "    # -----------------------------\n",
        "\n",
        "    inicio = timeit.default_timer()\n",
        "\n",
        "    encontrado_seq, comp_seq = busca_sequencial(dados, chave)\n",
        "\n",
        "    tempo_seq = timeit.default_timer() - inicio\n",
        "\n",
        "\n",
        "    # -----------------------------\n",
        "    # BUSCA JUMP\n",
        "    # -----------------------------\n",
        "\n",
        "    inicio = timeit.default_timer()\n",
        "    encontrado_jump, comp_jump = busca_jump(dados_ordenados, chave)\n",
        "\n",
        "    tempo_jump = timeit.default_timer() - inicio\n",
        "\n",
        "\n",
        "    # -----------------------------\n",
        "    # BUSCA BINÁRIA\n",
        "    # -----------------------------\n",
        "\n",
        "    inicio = timeit.default_timer()\n",
        "\n",
        "    encontrado_bin, comp_bin = busca_binaria(dados_ordenados, chave)\n",
        "\n",
        "    tempo_bin = timeit.default_timer() - inicio\n",
        "\n",
        "\n",
        "    resultados.append({\n",
        "        \"N\": N,\n",
        "        \"Tempo Sequencial (s)\": tempo_seq,\n",
        "        \"Tempo Jump (s)\": tempo_jump,\n",
        "        \"Tempo Binária (s)\": tempo_bin,\n",
        "        \"Comparações Sequencial\": comp_seq,\n",
        "        \"Comparações Jump\": comp_jump,\n",
        "        \"Comparações Binária\": comp_bin\n",
        "    })\n",
        "\n",
        "    # Liberar memória\n",
        "    del dados\n",
        "    del dados_ordenados\n",
        "    gc.collect()\n",
        "\n",
        "\n",
        "df = pd.DataFrame(resultados)\n",
        "\n",
        "df\n"
      ],
