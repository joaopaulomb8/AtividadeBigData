        "seq_norm = df[\"Comparações Sequencial\"] / df[\"Comparações Sequencial\"].max()\n",
        "jump_norm = df[\"Comparações Jump\"] / df[\"Comparações Jump\"].max()\n",
        "bin_norm = df[\"Comparações Binária\"] / df[\"Comparações Binária\"].max()\n",
        "\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "plt.plot(N, seq_norm, \"o-\", label=\"Sequencial experimental\")\n",
