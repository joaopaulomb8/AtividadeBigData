        "import numpy as np\n",
        "import timeit\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import gc\n",
        "\n",
        "print(\"Bibliotecas carregadas!\")\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def busca_sequencial(arr, chave):\n",
        "    num_comp = 0\n",
        "\n",
        "    for elemento in arr:\n",
        "        num_comp += 1\n",
        "\n",
        "        if elemento == chave:\n",
        "            return True, num_comp\n",
        "\n",
        "    return False, num_comp\n"
      ],
      "metadata": {
        "id": "yqw7tJZDwV2C"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def busca_jump(arr, chave):\n",
        "    n = len(arr)\n",
        "    num_comp = 0\n",
        "\n",
        "    if n == 0:\n",
        "        return False, num_comp\n",
        "\n",
        "    passo = int(np.sqrt(n))\n",
        "    inicio = 0\n",
        "\n",
        "    # Procura o bloco onde a chave pode estar\n",
        "    while inicio < n:\n",
        "        fim = min(inicio + passo, n)\n",
        "\n",
        "        num_comp += 1\n",
        "        if arr[fim - 1] >= chave:\n",
        "            break\n",
        "\n",
        "        inicio += passo\n",
        "\n",
        "    # Busca sequencial dentro do bloco\n",
        "    fim = min(inicio + passo, n)\n",
        "    for i in range(inicio, fim):\n",
        "        num_comp += 1\n",
        "\n",
        "        if arr[i] == chave:\n",
        "            return True, num_comp\n",
        "\n",
        "        # Como o vetor está ordenado, podemos parar\n",
        "        if arr[i] > chave:\n",
        "            return False, num_comp\n",
        "\n",
        "    return False, num_comp\n"
      ],
      "metadata": {
        "id": "XmcXXW04waLx"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def busca_binaria(arr, chave):\n",
        "    esquerda = 0\n",
        "    direita = len(arr) - 1\n",
        "    num_comp = 0\n",
        "    while esquerda <= direita:\n",
        "        meio = (esquerda + direita) // 2\n",
        "\n",
        "        num_comp += 1\n",
        "        if arr[meio] == chave:\n",
        "            return True, num_comp\n",
        "\n",
        "        num_comp += 1\n",
        "        if arr[meio] < chave:\n",
        "            esquerda = meio + 1\n",
        "        else:\n",
        "            direita = meio - 1\n",
        "\n",
        "    return False, num_comp\n"
      ],
      "metadata": {
        "id": "vvkeu2u5wh5o"
      },
      "execution_count": 5,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "dados = np.array([2, 5, 8, 12, 17, 23, 31, 40, 55])\n",
        "print(\"Sequencial:\", busca_sequencial(dados, 23))\n",
        "\n",
        "print(\"Jump:\", busca_jump(dados, 23))\n",
        "\n",
        "print(\"Binária:\", busca_binaria(dados, 23))\n"
